# Smart Krishi Sahayak - Environment Configuration Template
# Copy this file to .env and customize values for your local environment.

# Server Settings
PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=krishi_db
DB_USERNAME=root
DB_PASSWORD=root

# Spring Security JWT Configuration
# MUST be replaced with a secure 256-bit secret in production!
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Initial Admin Seeding Configuration
ADMIN_MOBILE=9999999999
ADMIN_EMAIL=admin@smartkrishi.gov.in
ADMIN_PASSWORD=Admin@123

# JPA / Hibernate DDL Auto Mode (none, validate, update, create-drop)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Application Environment Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev
