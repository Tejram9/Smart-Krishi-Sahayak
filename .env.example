# =============================================================================
# Smart Krishi Sahayak - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file or real production credentials to Git.
# =============================================================================

# Server Port (Vercel assigns PORT automatically at runtime; default is 8080)
PORT=8080

# -----------------------------------------------------------------------------
# Database Configuration (External MySQL / MariaDB for Production / Vercel)
# -----------------------------------------------------------------------------
# Option A: Full JDBC Connection URL (Recommended for cloud databases like Aiven, AWS RDS, PlanetScale, Clever Cloud)
# Format: jdbc:mysql://<host>:<port>/<database>?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=true
SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/your_db_name?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=true
# Alternatively, you can use DB_URL:
# DB_URL=jdbc:mysql://your-db-host:3306/your_db_name?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useSSL=true

# Option B: Individual database parameters (used if SPRING_DATASOURCE_URL is omitted)
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=krishi_db

# Database Credentials
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Database Driver & Hibernate Settings
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# -----------------------------------------------------------------------------
# Spring Profile
# -----------------------------------------------------------------------------
# Set to 'prod' for production deployments, or 'local' for local file-based H2 testing
SPRING_PROFILES_ACTIVE=prod

# -----------------------------------------------------------------------------
# Spring Security & JWT Authentication
# -----------------------------------------------------------------------------
# MUST be a securely generated 256-bit (64 hex characters or 32+ bytes) secret key!
# Generate using: openssl rand -hex 32
JWT_SECRET=your_secure_256_bit_random_hex_secret_key_here
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# Initial System Administrator Seeding
# -----------------------------------------------------------------------------
# Created on first startup if no administrator account exists in the database
APP_ADMIN_MOBILE=9999999999
APP_ADMIN_EMAIL=admin@smartkrishi.gov.in
APP_ADMIN_PASSWORD=your_secure_admin_password_min_12_chars

# -----------------------------------------------------------------------------
# Gemini AI Farming Assistant Configuration
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Weather Service Configuration
# -----------------------------------------------------------------------------
WEATHER_PROVIDER=open-meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=
WEATHER_TIMEOUT_MS=5000
WEATHER_CACHE_TTL_MINUTES=15

# -----------------------------------------------------------------------------
# CORS Configuration (Optional - Frontend and Backend are same-origin on Vercel)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins if accessing from an external frontend
APP_CORS_ALLOWED_ORIGINS=
